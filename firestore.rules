rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — the app's profile document.
    // Server-controlled fields (uid, phoneVerified, emailVerified, authProviders,
    // username, usernameLower, onboardingCompleted, createdAt) are only ever
    // written by Cloud Functions via the Admin SDK, which bypasses these rules
    // entirely. Client writes here are limited to a narrow, non-sensitive
    // allowlist so a signed-in user can update their own display info.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if false; // profile creation happens server-side (completeUserProfile)

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'updatedAt']);

      allow delete: if false;
    }

    // usernames/{usernameLower} — reservation records. Uniqueness is enforced
    // by a Cloud Functions transaction (reserveUsername); the client never
    // writes here directly, which is what prevents the check-then-write race
    // and arbitrary username squatting/overwriting.
    match /usernames/{usernameLower} {
      allow read: if false;
      allow write: if false;
    }

    // emailVerifications/{email} — short-lived OTP records (hashed code,
    // expiry, attempt count). Never client-readable or writable: leaking
    // this would leak the hash and metadata needed to brute-force the code.
    match /emailVerifications/{email} {
      allow read, write: if false;
    }

    // suppressedEmails/{email} — addresses Resend reported as bounced/
    // complained (written by the resendWebhook function via Admin SDK).
    // Client access would leak deliverability signals about arbitrary
    // addresses, so it's server-only like the collections above.
    match /suppressedEmails/{email} {
      allow read, write: if false;
    }

    // mediaUploads/{uploadId} — S3 upload authorization/status records
    // (Module 2). Entirely server-written: createMediaUploadUrl creates it,
    // confirmMediaUpload flips status to 'uploaded' after verifying the
    // object actually landed in S3. A client marking its own upload
    // "uploaded" would defeat that verification, so writes are server-only
    // like emailVerifications/usernames above. Read access lets a user see
    // their own upload's status; the owning uid is on the document itself.
    match /mediaUploads/{uploadId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // posts/{postId} — published posts (Module 6). Entirely server-written:
    // createPost re-verifies every referenced media upload and resolves
    // mentions before writing, which a client-side write could never be
    // trusted to do correctly, so writes are server-only like the
    // collections above. Read access follows the post's own audience field:
    // 'public' posts are readable by any signed-in user; 'followers'/
    // 'private' posts are author-only for now since no followers graph
    // exists yet in this app — a deliberately conservative default (never
    // leaks a restricted post) rather than a fabricated follower check.
    match /posts/{postId} {
      allow read: if request.auth != null
        && (resource.data.audience == 'public' || resource.data.authorId == request.auth.uid);
      allow write: if false;

      // posts/{postId}/comments/{commentId} — Real Home Feed. Entirely
      // server-written (createComment enforces allowComments and rate
      // limits before writing); the client never reads this subcollection
      // directly either — getComments returns it through the Admin SDK,
      // same "client never touches Firestore directly" posture as every
      // other collection here.
      match /comments/{commentId} {
        allow read, write: if false;
      }
    }

    // postLikes/{uid_postId}, postBookmarks/{uid_postId} — Real Home Feed.
    // Mirrors templateFavorites' exact posture: entirely server-written
    // (likePost/unlikePost/bookmarkPost/unbookmarkPost), read only through
    // the getMyPostInteractions callable, never directly by the client.
    match /postLikes/{id} {
      allow read, write: if false;
    }
    match /postBookmarks/{id} {
      allow read, write: if false;
    }

    // commentLikes/{uid_commentId} — same posture, one level deeper
    // (comment-level likes, likeComment/unlikeComment Cloud Functions).
    match /commentLikes/{id} {
      allow read, write: if false;
    }

    // follows/{followerId_followingId} — the real follow graph. Same
    // fully-server-only posture as postLikes/postBookmarks/commentLikes
    // above: entirely written by followUser/unfollowUser, read only
    // through the getUserProfile callable's single isFollowing lookup,
    // never directly by the client. followerCount/followingCount live on
    // users/{uid} instead (see that match block's own comment) — this
    // collection is just the relationship records themselves.
    match /follows/{id} {
      allow read, write: if false;
    }

    // notifications/{id} — created inline by likePost/createComment/
    // createPost (never a separate trigger). Unlike the collections above,
    // read directly by the owner rather than through a callable — same
    // "owner reads their own doc directly" posture posts/{postId} already
    // uses. The isRead/readAt mutation still only ever happens through
    // markNotificationRead, never a direct client write.
    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // sounds/{soundId} — user-uploaded personal sound library (Music Studio
    // Module 2). Entirely server-written: createSound re-verifies the
    // referenced mediaUploads record (owner, confirmed status, audio type)
    // before writing, so a client-side write could never be trusted to do
    // that correctly — same posture as mediaUploads/posts above. Read follows
    // the same public/private pattern playlists already uses: 'public'
    // sounds are readable by any signed-in user, 'private' ones owner-only.
    match /sounds/{soundId} {
      allow read: if request.auth != null
        && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    // playlists/{playlistId} — user-curated sound collections (Music Studio
    // Module 6). Entirely server-written: createPlaylist/updatePlaylist
    // re-verify every referenced soundId actually belongs to the caller
    // (verifyOwnedSoundIds) before writing, so a client-side write could
    // never be trusted to do that correctly — same posture as sounds above.
    // Read follows the same public/private pattern posts already uses:
    // 'public' playlists are readable by any signed-in user, 'private' ones
    // are owner-only.
    match /playlists/{playlistId} {
      allow read: if request.auth != null
        && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    // templateFavorites/{uid_templateId} — Module 8. Entirely server-written
    // (favoriteTemplate/unfavoriteTemplate Cloud Functions); the client never
    // reads this collection directly either — getFavoriteTemplates/
    // getTemplateDetail return favorite status/lists through the Admin SDK,
    // same "client never touches Firestore directly" posture as every other
    // collection here.
    match /templateFavorites/{favoriteId} {
      allow read, write: if false;
    }

    // templateUsage/{templateId} — Module 8. Real usage/favorite counters
    // layered onto the mock template catalog's seed numbers (see
    // functions/src/templates/service.ts) — server-only, same reasoning as
    // templateFavorites above.
    match /templateUsage/{templateId} {
      allow read, write: if false;
    }

    // rateLimits/{uid_bucket} — Module 10. Per-uid fixed-window counters
    // used by functions/src/lib/rateLimit.ts to blunt abuse of
    // cost-sensitive endpoints (e.g. presigned-upload-URL generation).
    // Entirely server-only — never read or written by the client.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // savedSounds/{uid_trackId} — Module 12. Per-user save/unsave of
    // catalog sounds, mirroring templateFavorites' exact posture: entirely
    // server-written (saveSound/unsaveSound), read only through the
    // getSavedSounds callable, never directly by the client.
    match /savedSounds/{id} {
      allow read, write: if false;
    }

    // liveSessions/{liveId} — Gistoneer Live. Entirely server-written:
    // createLiveSession/goLive/endLiveSession/joinAudience/leaveAudience all
    // re-verify the caller (host ownership, or just auth for a viewer) before
    // writing — a client-side write could never be trusted to set status or
    // viewerCount correctly, same posture as posts/sounds above. Read follows
    // the same public/private pattern: 'public' sessions are readable by any
    // signed-in user, 'private' ones owner-only (private access beyond that
    // is not implemented yet — a disclosed scope decision, not an oversight).
    match /liveSessions/{liveId} {
      allow read: if request.auth != null
        && (resource.data.visibility == 'public' || resource.data.hostId == request.auth.uid);
      allow write: if false;

      // liveSessions/{liveId}/ingestCredentials/secret — the real Agora
      // Media Gateway stream key for an external (OBS/vMix) broadcast.
      // Deliberately NOT on the parent doc above (readable by any signed-in
      // user for a public live) — a real publish credential must only ever
      // be readable by the host. Written only by startExternalStream
      // (Admin SDK).
      match /ingestCredentials/{docId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid;
        allow write: if false;
      }

      // liveSessions/{liveId}/audience/{uid} — live viewer-presence records
      // (joinAudience/leaveAudience idempotency, same {uid}_{targetId}
      // spirit as postLikes just as a subcollection) PLUS speak-request
      // state (speakStatus). A viewer may read only their OWN doc (to
      // detect their own approval/denial); the host may read any doc in
      // this subcollection (the pending-request queue) — pending requests
      // stay host-private, never broadly readable. The public-safe subset
      // of APPROVED speakers is separately denormalized onto the parent
      // liveSessions doc (activeSpeakers) so every viewer can render
      // speaker tiles without needing broader access here.
      match /audience/{uid} {
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid);
        allow write: if false;
      }

      // liveSessions/{liveId}/messages/{messageId} — live chat. Entirely
      // server-written (sendLiveMessage, rate-limited + length-capped).
      // Read follows the same direct-read/server-write split as
      // notifications/{id} (not posts/{id}/comments' fully-opaque one) —
      // chat genuinely needs push-based realtime the way notifications do.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/liveSessions/$(liveId)).data.visibility == 'public'
              || get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid);
        allow write: if false;
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
