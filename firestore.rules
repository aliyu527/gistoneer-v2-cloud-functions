rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Admin-aware rule primitives (Cloud Run cost-reduction migration) ---
    // Mirror functions/src/functions/admin/requireActiveAdmin.ts and
    // permissions.ts EXACTLY — same trust model (fresh admins/{uid} read on
    // every evaluation, role never trusted from the custom claim beyond the
    // coarse boolean pre-filter), same static 4-role -> permission table.
    // A rule's own get()/exists() call against admins/{uid} is NOT subject to
    // that document's own `allow read` rule below, so admins/{uid} can stay
    // closed to direct client reads (except the self-read exception) while
    // still being usable here to authorize every other collection.
    function activeAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActiveAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && activeAdminDoc().data.status == 'active';
    }
    function adminRole() {
      return activeAdminDoc().data.role;
    }
    // Verbatim mirror of ROLE_PERMISSIONS in functions/src/functions/admin/permissions.ts.
    function hasPermission(permission) {
      return isActiveAdmin() && (
        adminRole() == 'super_admin' ||
        (adminRole() == 'admin' && permission != 'admins.manage') ||
        (adminRole() == 'moderator' && permission in
          ['content.read', 'content.moderate', 'content.delete', 'sounds.read', 'sounds.moderate',
           'live.read', 'live.moderate', 'live.end', 'reports.read', 'reports.resolve']) ||
        (adminRole() == 'support' && permission in ['users.read', 'reports.read'])
      );
    }

    // --- Mobile-write-migration primitive ---
    // Security Rules can gate WHETHER a write is allowed but can't COMPUTE a
    // derived field (e.g. buildPublicUrl(storageKey,bucket,region) — see
    // confirmMediaUpload.ts, which now also stores that same computed
    // `publicUrl` directly on the mediaUploads doc for exactly this reason).
    // This checks a claimed artworkUploadId really belongs to the caller,
    // is a confirmed image upload, and that the write's own artworkUrl/
    // artworkStoragePath match that upload's own server-computed values
    // byte-for-byte — never trusting the client to have derived them itself.
    function verifiedImageUpload(uploadId, claimedUrl, claimedStoragePath) {
      let upload = get(/databases/$(database)/documents/mediaUploads/$(uploadId)).data;
      return upload.uid == request.auth.uid
        && upload.status == 'uploaded'
        && upload.mediaType == 'image'
        && claimedUrl == upload.publicUrl
        && claimedStoragePath == upload.storageKey;
    }

    // users/{uid} — the app's profile document.
    // Server-controlled fields (uid, phoneVerified, emailVerified, authProviders,
    // username, usernameLower, onboardingCompleted, createdAt) are only ever
    // written by Cloud Functions via the Admin SDK, which bypasses these rules
    // entirely. Client writes here are limited to a narrow, non-sensitive
    // allowlist so a signed-in user can update their own display info.
    match /users/{uid} {
      // Admin branch added for the adminListUsers/adminGetUserDetail direct-
      // read migration — no new exposure: the callable already returns
      // email/phone to the same set of admins (users.read holders), this
      // only moves which layer enforces that existing boundary.
      allow read: if (request.auth != null && request.auth.uid == uid) || hasPermission('users.read');

      allow create: if false; // profile creation happens server-side (completeUserProfile)

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'updatedAt']);

      allow delete: if false;
    }

    // usernames/{usernameLower} — reservation records. Uniqueness is enforced
    // by a Cloud Functions transaction (reserveUsername); the client never
    // writes here directly, which is what prevents the check-then-write race
    // and arbitrary username squatting/overwriting.
    match /usernames/{usernameLower} {
      allow read: if false;
      allow write: if false;
    }

    // emailVerifications/{email} — short-lived OTP records (hashed code,
    // expiry, attempt count). Never client-readable or writable: leaking
    // this would leak the hash and metadata needed to brute-force the code.
    match /emailVerifications/{email} {
      allow read, write: if false;
    }

    // suppressedEmails/{email} — addresses Resend reported as bounced/
    // complained (written by the resendWebhook function via Admin SDK).
    // Client access would leak deliverability signals about arbitrary
    // addresses, so it's server-only like the collections above.
    match /suppressedEmails/{email} {
      allow read, write: if false;
    }

    // mediaUploads/{uploadId} — S3 upload authorization/status records
    // (Module 2). Entirely server-written: createMediaUploadUrl creates it,
    // confirmMediaUpload flips status to 'uploaded' after verifying the
    // object actually landed in S3. A client marking its own upload
    // "uploaded" would defeat that verification, so writes are server-only
    // like emailVerifications/usernames above. Read access lets a user see
    // their own upload's status; the owning uid is on the document itself.
    match /mediaUploads/{uploadId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // posts/{postId} — published posts (Module 6). Entirely server-written:
    // createPost re-verifies every referenced media upload and resolves
    // mentions before writing, which a client-side write could never be
    // trusted to do correctly, so writes are server-only like the
    // collections above. Read access follows the post's own audience field:
    // 'public' posts are readable by any signed-in user; 'followers'/
    // 'private' posts are author-only for now since no followers graph
    // exists yet in this app — a deliberately conservative default (never
    // leaks a restricted post) rather than a fabricated follower check.
    //
    // Admin Panel Module 05 addition: a 'public' post also stops being
    // readable by anyone but its author once hideContent/removeContent (via
    // the Admin SDK, which bypasses this rule) sets moderationStatus to
    // 'hidden' or 'removed' — this is the ONLY real enforcement point for
    // those actions, since the mobile app reads posts directly via this rule
    // rather than through a callable. Narrowing-only: never grants more
    // access than before, and the author can still always see their own
    // post regardless of moderationStatus. IMPORTANT: every post predating
    // this field has no moderationStatus key at all — accessing it via dot
    // notation (resource.data.moderationStatus) THROWS in the rules
    // evaluator for a missing map key, which Firestore treats as a denied
    // read. That bug broke every legacy post's read (the entire home feed)
    // for several hours after the Module 05 deploy. Fixed by using get()
    // with an explicit default, matching the same 'active' default the
    // Cloud Functions themselves already use when reading this field.
    match /posts/{postId} {
      // Admin branch (content.read) intentionally bypasses the
      // audience/moderationStatus narrowing below — adminListContent needs
      // to see every audience and moderation state for moderation purposes,
      // matching what the Admin-SDK-backed callable already sees today.
      // analytics.read branch (getEngagementSummary/Trend, getContentAnalytics)
      // needs the same bypass — those functions count hidden/removed posts.
      allow read: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || (resource.data.audience == 'public'
                && !(resource.data.get('moderationStatus', 'active') in ['hidden', 'removed']))
            || hasPermission('content.read')
            || hasPermission('analytics.read'));
      allow write: if false;

      // posts/{postId}/comments/{commentId} — Real Home Feed. Still entirely
      // server-written (createComment enforces allowComments and rate
      // limits before writing — no rules equivalent, stays a Cloud
      // Function). getComments/getReplies migration (mobile read
      // migration): the moderationStatus filter MUST live in this rule, not
      // a client-side .where() a malicious client could omit — same
      // get()-with-default pattern as the parent posts/{postId} rule above
      // (same missing-key throw risk otherwise). postId is a literal path
      // segment fixed by this subcollection's own location, not a
      // per-candidate-document wildcard, so the get() below is the same
      // safe "fixed path for the whole query" shape already established —
      // not the liveSessions list-analyzer danger.
      match /comments/{commentId} {
        allow read: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || (!(resource.data.get('moderationStatus', 'active') in ['hidden', 'removed'])
                  && (get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
                      || get(/databases/$(database)/documents/posts/$(postId)).data.audience == 'public')));
        allow write: if false;
      }
    }

    // postLikes/{uid_postId}, postBookmarks/{uid_postId} — Real Home Feed.
    // Still entirely server-written: likePost/unlikePost/bookmarkPost/
    // unbookmarkPost all touch posts/{id}.counts.* on a DIFFERENT document
    // than the one being written here, and Security Rules can't require two
    // documents be written atomically together — a rule permitting a
    // non-owner to bump a counter by exactly +1 is real counter-fraud with
    // nothing tying it to an actual like/bookmark existing. Writes stay
    // Cloud Functions (see the mobile-write-migration plan's own writeup of
    // this exact tradeoff). getMyPostInteractions migration: read-only,
    // self-scoped by construction (doc id is {uid}_{postId}) — no PII, no
    // counter-fraud surface on a read.
    match /postLikes/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /postBookmarks/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // commentLikes/{uid_commentId} — same posture, one level deeper
    // (comment-level likes, likeComment/unlikeComment Cloud Functions stay
    // server-side for the same counter-fraud reason as postLikes above).
    // getMyCommentInteractions migration: read-only, self-scoped.
    match /commentLikes/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // follows/{followerId_followingId} — the real follow graph. Same
    // fully-server-only posture as postLikes/postBookmarks/commentLikes
    // above: entirely written by followUser/unfollowUser, read only
    // through the getUserProfile callable's single isFollowing lookup,
    // never directly by the client. followerCount/followingCount live on
    // users/{uid} instead (see that match block's own comment) — this
    // collection is just the relationship records themselves.
    match /follows/{id} {
      allow read, write: if false;
    }

    // notifications/{id} — created inline by likePost/createComment/
    // createPost (never a separate trigger). Unlike the collections above,
    // read directly by the owner rather than through a callable — same
    // "owner reads their own doc directly" posture posts/{postId} already
    // uses. The isRead/readAt mutation still only ever happens through
    // markNotificationRead, never a direct client write.
    // markNotificationRead migration: mirrors the already-shipped
    // adminNotifications/{id} update rule almost verbatim — own-inbox only,
    // isRead/readAt allowlist, one-directional (only ever set isRead to
    // true, never used to fake an unread state back).
    match /notifications/{id} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true;
      allow create, delete: if false;
    }

    // sounds/{soundId} — user-uploaded personal sound library (Music Studio
    // Module 2). Entirely server-written: createSound re-verifies the
    // referenced mediaUploads record (owner, confirmed status, audio type)
    // before writing, so a client-side write could never be trusted to do
    // that correctly — same posture as mediaUploads/posts above. Read follows
    // the same public/private pattern playlists already uses: 'public'
    // sounds are readable by any signed-in user, 'private' ones owner-only.
    //
    // Admin Panel Module 06 addition: a 'public' sound also stops being
    // readable by anyone but its owner once hideSound/removeSound (via the
    // Admin SDK, which bypasses this rule) sets moderationStatus to 'hidden'
    // or 'removed' — same narrowing-only pattern as Module 05's posts rule.
    // Never grants more access than before; the owner can still always see
    // their own sound regardless of moderationStatus. Uses get() with an
    // explicit default (not dot notation) — every sound predating this field
    // has no moderationStatus key, and dot-accessing a missing map key
    // throws in the rules evaluator, which Firestore treats as a denied
    // read. The identical mistake in the posts rule above broke the entire
    // home feed for several hours after the Module 05 deploy.
    match /sounds/{soundId} {
      // Admin branch (sounds.read) bypasses visibility/moderationStatus for
      // the same moderation-visibility reason as posts/{postId} above.
      // analytics.read branch (getMusicAnalytics) needs the same bypass to
      // count non-public sounds.
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid
            || (resource.data.visibility == 'public'
                && !(resource.data.get('moderationStatus', 'active') in ['hidden', 'removed']))
            || hasPermission('sounds.read')
            || hasPermission('analytics.read'));
      // updateSound migration: owner-only, metadata-field allowlist (never
      // moderationStatus/source/ownerId/audioUrl — those stay server-only),
      // artwork only ever set from a verified upload the caller actually
      // owns (verifiedImageUpload() above), never a client-supplied URL.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'titleLower', 'artist', 'album', 'genre', 'description', 'visibility', 'artworkUrl', 'artworkStoragePath', 'artworkUploadId', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['artworkUrl', 'artworkStoragePath'])
            || verifiedImageUpload(request.resource.data.artworkUploadId, request.resource.data.artworkUrl, request.resource.data.artworkStoragePath));
      allow create, delete: if false;
    }

    // soundCategories/{id} — admin-managed catalog categories (Trending/
    // Featured/Popular and genre-style browsable categories, distinguished
    // only by reserved slugs, never a separate schema). Client-readable
    // (mobile's category filter UI could read this directly if ever
    // needed) but entirely server-written — adminCreateSoundCategory/
    // adminUpdateSoundCategory are the only writers.
    match /soundCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // soundCategorySlugs/{slug} — uniqueness reservation for category slugs,
    // same fully-server-only shape as usernames/{usernameLower}.
    match /soundCategorySlugs/{slug} {
      allow read, write: if false;
    }

    // playlists/{playlistId} — user-curated sound collections (Music Studio
    // Module 6). Entirely server-written: createPlaylist/updatePlaylist
    // re-verify every referenced soundId actually belongs to the caller
    // (verifyOwnedSoundIds) before writing, so a client-side write could
    // never be trusted to do that correctly — same posture as sounds above.
    // Read follows the same public/private pattern posts already uses:
    // 'public' playlists are readable by any signed-in user, 'private' ones
    // are owner-only.
    match /playlists/{playlistId} {
      // Admin branch (sounds.read — adminListPlaylists checks this same
      // permission server-side today) bypasses visibility for moderation.
      // analytics.read branch (getMusicAnalytics) needs the same bypass to
      // count private playlists.
      allow read: if request.auth != null
        && (resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid || hasPermission('sounds.read') || hasPermission('analytics.read'));
      allow write: if false;
    }

    // templateFavorites/{uid_templateId} — Module 8. Entirely server-written
    // (favoriteTemplate/unfavoriteTemplate Cloud Functions); the client never
    // reads this collection directly either — getFavoriteTemplates/
    // getTemplateDetail return favorite status/lists through the Admin SDK,
    // same "client never touches Firestore directly" posture as every other
    // collection here.
    match /templateFavorites/{favoriteId} {
      allow read, write: if false;
    }

    // templateUsage/{templateId} — Module 8. Real usage/favorite counters
    // layered onto the mock template catalog's seed numbers (see
    // functions/src/templates/service.ts). favoriteCount stays server-only
    // (favoriteTemplate/unfavoriteTemplate pair it with a templateFavorites
    // doc — same cross-document counter-fraud gap as postLikes/follows, see
    // that writeup). recordTemplateUsage migration: usageCount specifically
    // already has ZERO ownership/rate-limit protection today (fire-and-
    // forget, any signed-in user, no relationship doc at all) — a rule
    // reproducing that exact posture for usageCount alone is not a
    // regression, just not something to also relax for favoriteCount.
    match /templateUsage/{templateId} {
      allow read: if false;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['usageCount']) && request.resource.data.usageCount == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
        && request.resource.data.usageCount == (resource.data.get('usageCount', 0)) + 1;
      allow delete: if false;
    }

    // rateLimits/{uid_bucket} — Module 10. Per-uid fixed-window counters
    // used by functions/src/lib/rateLimit.ts to blunt abuse of
    // cost-sensitive endpoints (e.g. presigned-upload-URL generation).
    // Entirely server-only — never read or written by the client.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // savedSounds/{uid_trackId} — Module 12. Per-user save/unsave of
    // catalog sounds. saveSound/unsaveSound migration: the cleanest write in
    // the whole mobile-migration inventory — no counter anywhere touches a
    // different document (confirmed: sounds/service.ts's saveSound/
    // unsaveSound only ever write this one doc), so none of the
    // cross-document counter-fraud reasoning elsewhere in this file applies.
    match /savedSounds/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.trackId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'trackId', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // liveSessions/{liveId} — Gistoneer Live. Entirely server-written:
    // createLiveSession/goLive/endLiveSession/joinAudience/leaveAudience all
    // re-verify the caller (host ownership, or just auth for a viewer) before
    // writing — a client-side write could never be trusted to set status or
    // viewerCount correctly, same posture as posts/sounds above. Read follows
    // the same public/private pattern: 'public' sessions are readable by any
    // signed-in user, 'private' ones owner-only (private access beyond that
    // is not implemented yet — a disclosed scope decision, not an oversight).
    match /liveSessions/{liveId} {
      // Split get/list (Cloud Run cost-reduction migration debugging):
      // Firestore's list-query safety analyzer must PROVE every possible
      // result satisfies the rule without per-document data. The exists()
      // clause below references $(liveId) — a path that varies per
      // candidate document — which the analyzer can't reason about across
      // an unconstrained query, so it rejects the ENTIRE list request
      // outright (not just filters out non-matching docs), regardless of
      // what the actual data looks like. Mobile's own live-browse query
      // (Services/Live/liveService.ts) always pre-filters
      // where('visibility','==','public') explicitly, which is what let it
      // avoid ever triggering this — admin's moderation view is
      // deliberately unfiltered (needs to see private sessions too), making
      // it the first real caller to hit this latent issue. `list` drops the
      // exists() clause entirely (mobile's list query never needs it — it
      // never lists private lives, only public ones); `get` (opening one
      // specific known live by ID, e.g. an invited viewer following a deep
      // link) keeps the full condition, preserving that feature exactly.
      allow get: if request.auth != null
        && (resource.data.visibility == 'public'
            || resource.data.hostId == request.auth.uid
            || (resource.data.visibility == 'private'
                && exists(/databases/$(database)/documents/liveSessions/$(liveId)/invited/$(request.auth.uid)))
            || hasPermission('live.read'));
      allow list: if request.auth != null
        && (resource.data.visibility == 'public'
            || resource.data.hostId == request.auth.uid
            || hasPermission('live.read'));
      allow write: if false;

      // liveSessions/{liveId}/invited/{uid} — a private live's invite list
      // (host-picks-viewers model, not followers-only/unlisted). Self-or-
      // host read only — never broadly readable, or a private live's guest
      // list would leak to anyone who could already read the parent doc.
      // Written only by inviteToLive (Admin SDK) — the REAL enforcement for
      // who can actually join is in joinAudience (Admin SDK bypasses these
      // rules entirely, so this exists() check alone would not stop a
      // non-invited user from getting a real Agora token).
      match /invited/{uid} {
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid);
        allow write: if false;
      }

      // liveSessions/{liveId}/ingestCredentials/secret — the real Agora
      // Media Gateway stream key for an external (OBS/vMix) broadcast.
      // Deliberately NOT on the parent doc above (readable by any signed-in
      // user for a public live) — a real publish credential must only ever
      // be readable by the host. Written only by startExternalStream
      // (Admin SDK).
      match /ingestCredentials/{docId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid;
        allow write: if false;
      }

      // liveSessions/{liveId}/audience/{uid} — live viewer-presence records
      // (joinAudience/leaveAudience idempotency, same {uid}_{targetId}
      // spirit as postLikes just as a subcollection) PLUS speak-request
      // state (speakStatus). A viewer may read only their OWN doc (to
      // detect their own approval/denial); the host may read any doc in
      // this subcollection (the pending-request queue) — pending requests
      // stay host-private, never broadly readable. The public-safe subset
      // of APPROVED speakers is separately denormalized onto the parent
      // liveSessions doc (activeSpeakers) so every viewer can render
      // speaker tiles without needing broader access here.
      match /audience/{uid} {
        allow read: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid);
        allow write: if false;
      }

      // liveSessions/{liveId}/messages/{messageId} — live chat. Entirely
      // server-written (sendLiveMessage, rate-limited + length-capped).
      // Read follows the same direct-read/server-write split as
      // notifications/{id} (not posts/{id}/comments' fully-opaque one) —
      // chat genuinely needs push-based realtime the way notifications do.
      //
      // Admin Panel Module 07 addition: a message also stops being readable
      // by anyone once deleteLiveMessage (via the Admin SDK, which bypasses
      // this rule) sets deleted:true — narrowing-only, same pattern as
      // Module 05/06's moderationStatus rules. Uses resource.data.get() with
      // an explicit default, NOT dot notation (resource.data.deleted) —
      // every message predates this field, and dot-accessing a missing map
      // key throws in the rules evaluator, which Firestore treats as a
      // denied read. That exact mistake (moderationStatus dot-access on
      // posts/sounds) broke the entire home feed for hours after the
      // Module 05 deploy; get() with a default avoids repeating it here.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && !resource.data.get('deleted', false)
          && (get(/databases/$(database)/documents/liveSessions/$(liveId)).data.visibility == 'public'
              || get(/databases/$(database)/documents/liveSessions/$(liveId)).data.hostId == request.auth.uid
              || (get(/databases/$(database)/documents/liveSessions/$(liveId)).data.visibility == 'private'
                  && exists(/databases/$(database)/documents/liveSessions/$(liveId)/invited/$(request.auth.uid))));
        allow write: if false;
      }
    }

    // adminAuditLogs/{id} — Module 04. Records of admin actions (suspend/
    // unsuspend a user, etc.), written by writeAuditLog() via the Admin SDK.
    // adminListAuditLogs/adminGetAuditLogDetail migration: audit.read is the
    // ONLY permission gated in here — the full raw document is already the
    // intended read surface for that permission (confirmed by
    // adminGetAuditLogDetail's own comment: "the collection has no separate
    // summary/detail split"). adminListModerationHistory/
    // adminListNotificationCampaigns/adminListSettingsHistory ALSO read this
    // same shared collection (filtered to different action subsets) but are
    // gated by reports.read/notifications.read/settings.read — deliberately
    // NOT added here, since their callables curate a narrower field subset
    // (no metadata, no actorUid) than this collection's raw documents; a
    // blanket permission-OR would leak those fields to holders of those
    // other permissions who were never meant to see them. Those three stay
    // Cloud Functions.
    match /adminAuditLogs/{id} {
      allow read: if hasPermission('audit.read');
      allow write: if false;
    }

    // admins/{uid} — Module 04+. The RBAC source of truth (role, status),
    // re-read live by requireActiveAdmin on every privileged call. Module 14:
    // this was previously only covered by the file's closing default-deny
    // catch-all rather than an explicit block like every other sensitive
    // collection — made explicit here for the same defense-in-depth/
    // self-documentation reasons, no behavior change (still fully
    // server-only via the Admin SDK).
    match /admins/{uid} {
      // Self-read (getMyAdminProfile migration) plus admins.read for the
      // adminListAdmins migration — role/status changes stay fully
      // server-only. Note the self-read exception was NEVER what made
      // hasPermission() work elsewhere in this file: a rule's own get() call
      // against this path bypasses this document's own `allow read` entirely,
      // so every hasPermission()/isActiveAdmin() check above already worked
      // before this line existed. `list` additionally caps request.query.limit
      // — defense-in-depth since this is the RBAC source-of-truth collection
      // getting bulk-list access for the first time; no new FIELDS are
      // exposed vs. today's adminListAdmins callable (same audience, same
      // shape), but an unbounded client query could otherwise enumerate the
      // whole admin roster in one call where the callable capped pages at 50.
      allow get: if (request.auth != null && request.auth.uid == uid) || hasPermission('admins.read');
      allow list: if hasPermission('admins.read') && request.query.limit <= 50;
      allow write: if false;
    }

    // adminNotifications/{id} — Admin Notification System. Each doc targets
    // one recipient admin (recipientId). Fully server-only, matching the
    // regular notifications/{id} collection's own precedent (that collection
    // is also allow write: if false even for isRead — mark-as-read goes
    // through markNotificationRead, never a direct client field update) —
    // not the users/{uid} partial-field-allowlist pattern. Every read
    // (getAdminNotifications, getUnreadAdminNotificationCount) and mutation
    // (markAdminNotificationRead, markAllAdminNotificationsRead) goes through
    // a callable that independently verifies recipientId == request.auth.uid,
    // since these rules give the client no access to lean on at all.
    match /adminNotifications/{id} {
      // getAdminNotifications/getUnreadAdminNotificationCount/
      // markAdminNotificationRead migration — own-inbox only, mirrors the
      // regular notifications/{id} rule's read posture exactly. The update
      // clause mirrors users/{uid}'s partial-field-allowlist pattern: only
      // isRead/readAt may change, and only to true (never used to fake an
      // unread state back or touch any other field).
      allow read: if isActiveAdmin() && resource.data.recipientId == request.auth.uid;
      allow update: if isActiveAdmin()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true;
      allow create, delete: if false;
    }

    // settings/{docId} — Module 13. Platform-wide feature flags, maintenance
    // mode, and media size limits (settings/platform). Every OTHER consumer
    // (createPost, createLiveSession, etc.) still reads via the cached
    // Admin-SDK getPlatformSettings() helper server-side, unaffected by this.
    // getPlatformSettingsAdmin migration: single-doc get, not a list query —
    // no exists()/get() per-document-wildcard concern applies at all. Scoped
    // to the one real doc id rather than a blanket allow, since nothing else
    // is ever expected to live in this collection. Written only via
    // updatePlatformSettings (settings.write permission) — still server-only.
    match /settings/{docId} {
      allow get: if docId == 'platform' && hasPermission('settings.read');
      allow list: if false;
      allow write: if false;
    }

    // vendors/{uid} — Marketplace vendor application + shop profile, one
    // evolving doc per user (doc id == uid), same "one doc, evolving status"
    // shape admins/{uid} already uses. Entirely server-written
    // (submitVendorApplication/updateShop/admin approve-reject-suspend).
    // Owner always reads their own doc (any status, including
    // pending/rejected — their own application). Everyone else can read it
    // only once it's a real public shop (status=='approved') — a pending or
    // rejected application is private.
    match /vendors/{uid} {
      // Admin branch (marketplace.read — adminListVendors checks this same
      // permission server-side today) bypasses status so pending/rejected
      // applications remain visible to admins for review.
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.status == 'approved' || hasPermission('marketplace.read'));
      allow write: if false;
    }

    // listings/{listingId} — Marketplace products/services (unified model,
    // `type` discriminates). Entirely server-written (createListing/
    // updateListing re-verify every referenced media upload and the
    // caller's own vendor status before writing). Owner always reads their
    // own listing (any status, including draft/suspended — visible in "My
    // Shop"). Everyone else only if published AND the denormalized
    // vendorStatus is 'approved' — a suspended vendor's listings must stop
    // being visible even though Firestore can't join to the live vendors/
    // {vendorId} doc in a rule/query. Uses get() with an explicit default
    // (not dot notation) for the same reason as the posts/sounds/messages
    // rules above — every field here is new, and today's outage already
    // proved what a bare dot-access on a possibly-missing field does.
    match /listings/{listingId} {
      // Admin branch (marketplace.read — adminListListings checks this same
      // permission server-side today) bypasses status/vendorStatus: an admin
      // reviewing a suspended vendor's listings, or a still-draft listing,
      // needs full visibility, matching the Admin-SDK-backed callable today.
      allow read: if request.auth != null
        && (resource.data.vendorId == request.auth.uid
            || (resource.data.status == 'published' && resource.data.get('vendorStatus', 'approved') == 'approved')
            || hasPermission('marketplace.read'));
      allow write: if false;
    }

    // reports/{reportId} — Module 10. Entirely callable-only in both
    // directions, mirroring vendors/listings: submitReport writes it
    // server-side (reporter identity, target snapshot, rate limiting all
    // enforced there), and no client — including the reporter — reads a
    // report directly. Reporter identity and moderation notes are
    // investigation-only data for admins (via the Admin SDK, which bypasses
    // these rules), never exposed to any authenticated app user.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
